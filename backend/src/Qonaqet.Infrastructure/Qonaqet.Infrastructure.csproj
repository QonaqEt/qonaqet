<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../Qonaqet.Application/Qonaqet.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.* NuGet paketləri əvəzinə paylaşılan framework (allowlist-ə əlavə paket lazım deyil). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="FirebaseAdmin" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <!-- Email şablonları və dizayn token-ləri (tək mənbə: design-tokens/tokens.json) assembly-yə daxil edilir. -->
    <EmbeddedResource Include="Email/Templates/**/*" />
    <EmbeddedResource Include="Documents/Pdf/Templates/**/*.html" />
    <EmbeddedResource Include="Documents/Pdf/Fonts/*.ttf" />
    <EmbeddedResource Include="../../../design-tokens/tokens.json" LogicalName="Qonaqet.DesignTokens.json" Link="Email/tokens.json" />
  </ItemGroup>

</Project>
