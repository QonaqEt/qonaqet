# QONAQET dev mühiti — deploy/docker-compose.yml-in oxuduğu bütün dəyişənlər.
#
#   cp deploy/env/.env.example deploy/env/.env
#   docker compose -f deploy/docker-compose.yml --env-file deploy/env/.env up -d --wait
#
# Buradakı dəyərlər YALNIZ lokal dev üçündür və compose faylındakı default-larla eynidir.
# Real sirr (Payriff açarı, prod parolları) bu fayla YAZILMIR; deploy/env/.env git-ə düşmür.

# ---------- tətbiq ----------
# Hədiyyə linkləri və ödəniş callback-ləri üçün public baza URL (App:PublicBaseUrl).
APP_PUBLIC_BASE_URL=http://localhost:4200
# Boş saxla → Fake ödəniş gateway-i işləyir. Real Payriff açarını yalnız lokal .env-ə yaz.
PAYRIFF_APP_KEY=
# JWT imza açarı (dev). Staging/prod-da mühit sirrindən gəlir.
JWT_SIGNING_KEY=qonaqet-dev-only-signing-key-change-me-0123456789
# FIN hash-i üçün HMAC sirri (dev).
FIN_HASH_SECRET=qonaqet-dev-only-fin-secret
# Hədiyyə/claim QR payload-larının HMAC sirri (dev).
QR_SIGNING_SECRET=qonaqet-dev-only-qr-secret

# ---------- MongoDB (replica set rs0, dev-də autentifikasiyasız, yalnız localhost) ----------
MONGO_PORT=27017
MONGO_DATABASE=qonaqet

# ---------- PostgreSQL ----------
POSTGRES_PORT=5432
POSTGRES_DB=qonaqet
POSTGRES_USER=qonaqet
POSTGRES_PASSWORD=qonaqet-dev-only

# ---------- Valkey ----------
VALKEY_PORT=6379

# ---------- RabbitMQ ----------
RABBITMQ_PORT=5672
# İdarəetmə paneli: http://localhost:15672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=qonaqet
RABBITMQ_PASSWORD=qonaqet-dev-only

# ---------- RustFS (S3 API) ----------
RUSTFS_PORT=9000
# Konsol: http://localhost:9001
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=qonaqet
RUSTFS_SECRET_KEY=qonaqet-dev-only
# rustfs-init bu bucket-i yaradır və versioning-i açır (vergüllə bir neçə ad ola bilər).
STORAGE_BUCKET=qonaqet-files

# ---------- Mailpit (dev SMTP) ----------
MAILPIT_SMTP_PORT=1025
# Gələn məktublar: http://localhost:8025
MAILPIT_UI_PORT=8025

# ---------- Aspire Dashboard (dev izləmə) ----------
# UI: http://localhost:18888
ASPIRE_UI_PORT=18888
# OTLP gRPC girişi (host-da işləyən servislər üçün).
ASPIRE_OTLP_PORT=4317

# ---------- tətbiq portları (--profile apps) ----------
API_PORT=5080
INTEGRATION_API_PORT=5081
LANDING_PORT=4200
BUSINESS_PORTAL_PORT=4201
ADMIN_PORT=4202
