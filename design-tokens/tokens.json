{
  "$description": "QONAQET design token-lərinin YEGANƏ mənbəyi (CLAUDE.md → Brand). Rəng/şrift yalnız buradan dəyişir; UI həmkarı palitranı burada yeniləyə bilər.",
  "color": {
    "brand": {
      "nar":     { "$type": "color", "$value": "#E8475F", "$description": "primary — səxavət, CTA, hədiyyə anları" },
      "saffron": { "$type": "color", "$value": "#FFB72B", "$description": "secondary — istilik, vurğu, nişanlar" },
      "mint":    { "$type": "color", "$value": "#16B89B", "$description": "accent — kömək/etibar, uğur, ismarla" },
      "plum":    { "$type": "color", "$value": "#2A1A3E", "$description": "ink — mətn, tünd bölmələr" },
      "cream":   { "$type": "color", "$value": "#FFF8EF", "$description": "surface — fonlar" },
      "blush":   { "$type": "color", "$value": "#FFE3E6", "$description": "yumşaq kartlar" }
    },
    "gradient": {
      "sunrise": {
        "start": { "$type": "color", "$value": "{color.brand.nar}" },
        "end":   { "$type": "color", "$value": "{color.brand.saffron}" }
      },
      "together": {
        "start": { "$type": "color", "$value": "{color.brand.mint}" },
        "end":   { "$type": "color", "$value": "{color.brand.plum}" }
      }
    },
    "text": {
      "default":   { "$type": "color", "$value": "{color.brand.plum}",  "$description": "cream/blush fon üzərində" },
      "onSaffron": { "$type": "color", "$value": "{color.brand.plum}",  "$description": "saffron üzərində mətn həmişə plum-dur" },
      "onPlum":    { "$type": "color", "$value": "{color.brand.cream}" },
      "onNar":     { "$type": "color", "$value": "{color.brand.cream}", "$description": "yalnız iri/qalın mətn (AA-large) — bax contrast-pairs.json" }
    },
    "theme": {
      "$description": "Hədiyyə temalarının vurğu rəngləri — TƏKLİFDİR, UI həmkarı təsdiqləyənə qədər.",
      "birthday":    { "$type": "color", "$value": "{color.brand.saffron}" },
      "love":        { "$type": "color", "$value": "{color.brand.nar}" },
      "thanks":      { "$type": "color", "$value": "{color.brand.mint}" },
      "family":      { "$type": "color", "$value": "#F08A4B" },
      "congrats":    { "$type": "color", "$value": "#7B5CD6" },
      "justBecause": { "$type": "color", "$value": "#FF7AA2" },
      "corporate":   { "$type": "color", "$value": "{color.brand.plum}" }
    }
  },
  "font": {
    "family": {
      "ui":      { "$type": "fontFamily", "$value": "Manrope",   "$description": "UI mətni; Azərbaycan hərflərini dəstəkləyir" },
      "display": { "$type": "fontFamily", "$value": "Unbounded", "$description": "başlıqlar" }
    }
  }
}
